# ============================================================================
# Prospecta: configuração local. Copie para ".env" (ou rode: python -m app.cli init)
# Nunca envie o arquivo .env para o GitHub: ele contém chaves secretas.
# ============================================================================

# Token do administrador (painel web). Gerado automaticamente pelo "init".
ADMIN_TOKEN=

# Endereço do servidor. 127.0.0.1 = só este computador (recomendado).
HOST=127.0.0.1
PORT=8000
APP_TIMEZONE=America/Sao_Paulo
DATABASE_PATH=data/prospecta.db

# --- Google Places API (New) -------------------------------------------------
# Crie em https://console.cloud.google.com: ative a "Places API (New)", habilite
# o faturamento e gere uma chave. Restrinja a chave à Places API.
GOOGLE_PLACES_API_KEY=
# Limite mensal de chamadas (o Google dá 1.000 grátis/mês por SKU). Ao atingir,
# o sistema para de chamar a API. Aumente só se aceitar pagar pelo excedente.
GOOGLE_TEXTSEARCH_MONTHLY_LIMIT=900
GOOGLE_DETAILS_MONTHLY_LIMIT=900
# Prazo para manter conteúdo do Google (exceto place_id) antes de atualizar/remover.
GOOGLE_CACHE_DAYS=30

# --- IA opcional (API do Claude) ---------------------------------------------
# Sem chave, análises e mensagens usam regras e modelos próprios (grátis).
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# --- Análise de sites ---------------------------------------------------------
SITE_ANALYSIS_USER_AGENT=ProspectaBot/1.0 (analise de presenca digital; visita unica a pagina inicial)
SITE_TIMEOUT_SECONDS=10

# Limite de requisições por token por minuto (protege contra uso excessivo)
API_RATE_LIMIT_PER_MINUTE=240
